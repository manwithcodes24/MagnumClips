# MagnumClips Environment Variables

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEFAULT_TTS_PROVIDER=deepgram

# Local Supabase — spun up via docker-compose (no external project needed)
# These are the standard Supabase demo keys for local development.
# For production, replace with your hosted Supabase project values.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Database — local Supabase PostgreSQL (port 54322 from Docker)
# Production: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:magnumclips@localhost:54322/postgres

# Redis — local Docker or managed (Upstash, etc.)
# Local:   redis://localhost:6379/0
# Upstash: rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=./storage

# Admin emails (comma-separated) — bypass all subscription limits
ADMIN_EMAILS=admin@example.com
